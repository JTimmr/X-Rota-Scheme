DISCORD_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here
SCHEDULED_CHANNEL_ID=channel_id_for_scheduled_posts
ARCHIVE_CHANNEL_ID=channel_id_for_historical_posts
REMINDERS_CHANNEL_ID=channel_id_for_reminders

# Optional alert role (falls back to recently active users)
ROTA_ALERT_ROLE_ID=

# Optional timezone shown on the CTO X live rota image
ROTA_TIMEZONE=Europe/London

# X/Twitter API (optional — leave blank to disable auto-posting to X)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional channels for successful x.com links
X_LIVE_POST_LINK_CHANNEL_ID_1=
X_LIVE_POST_LINK_CHANNEL_ID_2=
